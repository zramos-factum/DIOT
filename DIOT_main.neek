:33\"  },  {    \"nombre_cliente\": \"Grupo Zeta\",    \"status\": \"OK\",    \"tiempo\": \"10:55:01\"  },  {    \"nombre_cliente\": \"Innovación Digital\",    \"status\": \"ERROR\",    \"tiempo\": \"11:02:18\"  },  {    \"nombre_cliente\": \"Roberto Gómez\",    \"status\": \"OK\",    \"tiempo\": \"11:15:40\"  },  {    \"nombre_cliente\": \"Comercializadora Alfa\",    \"status\": \"OK\",    \"tiempo\": \"11:20:07\"  }]","use_previous_step":false},"is_variable_global":false,"condition":null,"basicCondition":null,"conditionType":"basic","delay_ms":0,"delay_sec":{"value":0.25,"use_previous_step":false},"subroutine_path":null,"comment":null,"command":{"use_previous_step":false},"breakpoint":false,"deactivated":true,"background":false,"log_details":{"use_previous_step":false},"log_message":{"use_previous_step":false},"log_severity":"info","app_title":null,"launch_params":null,"password":null,"iterator_id":null,"iterator_source":{"use_previous_step":false},"fields_map":null,"js_file_path":null,"username":null,"timeout":0}},"position":{"x":74,"y":5440.95009765625},"next":{"exit":{"activity_category":1,"activity":{"cell_id":"488e2a02-feac-45df-9a19-f4b7730305a6","code":12,"params":{"version":"4.35.0","last_code_change":"9.4.0","last_user_modification":"12.0.6","variable_name":"$previous_result$","variable_value":{"use_previous_step":false,"statement":"\r\n// 1. Convert the canvas variable 'clientsData' from a string to a readable JSON array.\r\n// The typeof check ensures it won't crash if Electroneek already parsed it automatically.\r\nlet parsedData = typeof clientsData === 'string' ? JSON.parse(clientsData) : clientsData;\r\n\r\n// 2. Loop through the parsed data and build the table rows\r\nlet tableRows = \"\";\r\n\r\nparsedData.forEach(client => {\r\n    let cssClass = (client.status === \"OK\") ? \"status-success\" : \"status-failed\";\r\n    \r\n    tableRows += `<tr>\r\n        <td>${client.nombre_cliente}</td>\r\n        <td class=\"${cssClass}\">${client.status}</td>\r\n        <td>${client.tiempo}</td>\r\n    </tr>`;\r\n});\r\n\r\n// 3. Your HTML Template\r\nbody = `<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>RPA Process Report</title>\r\n    <style>\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            background-color: #f4f4f4;\r\n            margin: 0;\r\n            padding: 20px;\r\n        }\r\n        .email-container {\r\n            max-width: 600px;\r\n            margin: 0 auto;\r\n            background-color: #ffffff;\r\n            border-radius: 8px;\r\n            overflow: hidden;\r\n            box-shadow: 0 4px 10px rgba(0,0,0,0.1);\r\n        }\r\n        .header {\r\n            background-color: #0056b3;\r\n            color: #ffffff;\r\n            padding: 20px;\r\n            text-align: center;\r\n        }\r\n        .content {\r\n            padding: 20px;\r\n            color: #333333;\r\n        }\r\n        table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            margin-top: 15px;\r\n        }\r\n        th, td {\r\n            padding: 12px;\r\n            text-align: left;\r\n            border-bottom: 1px solid #dddddd;\r\n        }\r\n        th {\r\n            background-color: #f8f9fa;\r\n            font-weight: bold;\r\n            color: #333;\r\n        }\r\n        .status-success {\r\n            color: #28a745;\r\n            font-weight: bold;\r\n        }\r\n        .status-failed {\r\n            color: #dc3545;\r\n            font-weight: bold;\r\n        }\r\n        .footer {\r\n            background-color: #f8f9fa;\r\n            padding: 15px;\r\n            text-align: center;\r\n            font-size: 12px;\r\n            color: #666666;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"email-container\">\r\n        <div class=\"header\">\r\n            <h2 style=\"margin: 0;\">RPA Execution Summary</h2>\r\n        </div>\r\n        <div class=\"content\">\r\n            <p>Hello Team,</p>\r\n            <p>The monthly client loop process has finished executing. Below is the status breakdown for each client:</p>\r\n            \r\n            <table>\r\n                <thead>\r\n                    <tr>\r\n                        <th>Client Name</th>\r\n                        <th>Execution Status</th>\r\n                        <th>Timestamp</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    {{DYNAMIC_TABLE_ROWS}}\r\n                </tbody>\r\n            </table>\r\n\r\n            <p style=\"margin-top: 20px;\">Please check the RPA logs if any clients resulted in a failed status.</p>\r\n        </div>\r\n        <div class=\"footer\">\r\n            Automated message generated by RPA Bot. Please do not reply.\r\n        </div>\r\n    </div>\r\n</body>\r\n</html>`;\r\n\r\n// 4. Inject the rows into the HTML template\r\nbody = body.replace('{{DYNAMIC_TABLE_ROWS}}', tableRows);\r\n\r\n// 5. Output the final string\r\nreturn body;"},"is_variable_global":false,"condition":null,"basicCondition":null,"conditionType":"basic","delay_ms":0,"delay_sec":{"value":0.25,"use_previous_step":false},"subroutine_path":null,"comment":"EMAIL BODY HTML","command":{"use_previous_step":false},"breakpoint":false,"deactivated":true,"background":false,"log_details":{"use_previous_step":false},"log_message":{"use_previous_step":false},"log_severity":"info","app_title":null,"launch_params":null,"password":null,"iterator_id":null,"iterator_source":{"use_previous_step":false},"fields_map":null,"js_file_path":"DIOT_main_1.js","username":null,"timeout":0}},"position":{"x":62,"y":5581.35},"next":{"exit":{"activity_category":7,"activity":{"cell_id":"552f03ef-c63c-4de3-9e72-a277f65ca8bc","code":1,"params":{"version":"4.35.0","last_code_change":"9.4.0","last_user_modification":"12.0.6","to":{"value":"zramos@factum-partners.com","use_previous_step":false},"cc":{"value":"aacuna@factum-